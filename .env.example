# MedSim: configuración central de backend y Docker Compose.
# Copiar a .env. No versionar credenciales. Usar comillas simples si contienen $ o #.
# Los cambios se aplican recreando contenedores; imágenes base requieren rebuild.

# --- APLICACIÓN ---
PROJECT_NAME=MedSim
HOST=0.0.0.0
# Puerto del proceso (también dentro de Docker).
PORT=8000
DEBUG=False
BOOTSTRAP_DEMO=False
LOG_LEVEL=info
ACCESS_LOG=True
# Habilitar cuando haya un proxy reverso (Nginx). Ver README sección 6.
PROXY_HEADERS=False
FORWARDED_ALLOW_IPS=127.0.0.1
GRACEFUL_TIMEOUT_SECONDS=30
# Contraseña de acceso al sitio. Vacío = sin login (desarrollo). Definir en producción.
SITE_PASSWORD=
# Clave para firmar cookies de sesión. SIEMPRE cambiar antes de desplegar.
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Cambiar a True si la aplicación se sirve bajo HTTPS / SSL en producción
SECURE_COOKIES=False

# --- DOCKER / RED ---
# Mantener estable el nombre: determina los nombres de los volúmenes de datos.
COMPOSE_PROJECT_NAME=medsim
APP_IMAGE=medsim:local
NODE_IMAGE=node:22-slim
PYTHON_IMAGE=python:3.12-slim
MONGO_IMAGE=mongo:8
RESTART_POLICY=unless-stopped
# 127.0.0.1 para proxy en el host. Usar la IP del servidor para acceso desde la LAN.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=8000
# Mongo se publica solo en loopback para desarrollo/administración local.
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_HOST_PORT=27017

# --- MONGO ---
MONGO_DB_NAME=medsim
# Conexión local fuera de Docker; vaciar usuario/clave si no hay autenticación.
MONGO_URL=mongodb://localhost:27017/medsim
MONGO_USER=
MONGO_PASSWORD=
# Docker sustituye MONGO_URL y usa las credenciales ROOT de abajo para la app.
# Mantener esta URI sin credenciales; el backend las agrega y codifica.
DOCKER_MONGO_URL=mongodb://mongo:27017/medsim?authSource=admin
MONGO_ROOT_USERNAME=admin
# Obligatoria. En una base existente hay que rotarla también dentro de Mongo.
MONGO_ROOT_PASSWORD=

# --- RECURSOS / LOGS ---
# Valores iniciales ajustables: no constituyen una prueba de capacidad para 40 usuarios.
APP_CPUS=2
APP_MEMORY_LIMIT=2g
MONGO_CPUS=2
MONGO_MEMORY_LIMIT=2g
STOP_GRACE_PERIOD=45s
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# --- HEALTHCHECKS ---
APP_HEALTH_INTERVAL=30s
APP_HEALTH_TIMEOUT=10s
APP_HEALTH_RETRIES=3
APP_HEALTH_START_PERIOD=90s
MONGO_HEALTH_INTERVAL=10s
MONGO_HEALTH_TIMEOUT=10s
MONGO_HEALTH_RETRIES=5
MONGO_HEALTH_START_PERIOD=40s

# --- LLM (PACIENTE IA) ---
PATIENT_LLM_URL=https://api.groq.com/openai/v1
PATIENT_LLM_API_KEY=
PATIENT_LLM_MODEL=openai/gpt-oss-120b
# Ajustar según la red del host; localhost dentro del contenedor es el contenedor.
OLLAMA_URL=http://host.docker.internal:11434

# --- STT (AUDIO A TEXTO) ---
STT_API_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3

# --- TTS (TEXTO A AUDIO) ---
# Opción 1: Microservicio Docker / Local TTS-ar (Piper VITS Argentino) [RECOMENDADO]
# - Si MedSim y TTS corren en Docker (misma red): http://tts:8000
# - Si MedSim corre en Docker y TTS en el host Windows: http://host.docker.internal:8001
# - Si MedSim corre en local fuera de Docker: http://localhost:8001
TTS_API_URL=http://tts:8000
TTS_API_KEY=
TTS_VOICE_ID=1
TTS_SPEED=1.0
TTS_TEMPERATURE=0.5

# Opción 2: Cartesia Cloud SaaS
# TTS_API_URL=https://api.cartesia.ai
# TTS_API_KEY=
# TTS_VOICE_ID=
# TTS_MODEL_ID=sonic
# TTS_LANGUAGE=es

